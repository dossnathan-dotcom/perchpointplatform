FROM node:22-bookworm AS build
WORKDIR /app
COPY frontend/package.json frontend/yarn.lock /app/
RUN corepack enable && corepack yarn install --frozen-lockfile --non-interactive
COPY frontend /app
ENV CI=true
ENV REACT_APP_PHASE3_ENVIRONMENT=local
ENV REACT_APP_SHOW_DEMO_LABELS=true
ENV REACT_APP_ENABLE_SEEDED_PREVIEWS=true
RUN corepack yarn build

FROM python:3.13-slim
COPY deploy/purge_old_packages.py /tmp/purge_old_packages.py
RUN python -m pip install --no-cache-dir --upgrade "setuptools==84.0.0" "wheel==0.46.2" "jaraco.context==6.1.0" "msgpack==1.2.1" \
    && rm -rf /usr/local/lib/python3.13/ensurepip \
    && find /usr /root -name '*.whl' -delete \
    && python /tmp/purge_old_packages.py \
    && rm /tmp/purge_old_packages.py \
    && useradd --create-home --uid 10001 perchpoint
COPY deploy/static_server.py /srv/static_server.py
COPY --from=build /app/build /srv/web
RUN chown -R perchpoint:perchpoint /srv
USER perchpoint
EXPOSE 8080
CMD ["python", "/srv/static_server.py"]
