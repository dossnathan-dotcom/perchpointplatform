FROM node:22-bookworm AS build
WORKDIR /app
COPY frontend/package.json frontend/yarn.lock /app/
RUN corepack enable && corepack yarn install --frozen-lockfile --non-interactive
COPY frontend /app
ENV CI=true
ENV REACT_APP_PHASE3_ENVIRONMENT=local
ENV REACT_APP_SHOW_DEMO_LABELS=true
ENV REACT_APP_ENABLE_SEEDED_PREVIEWS=true
RUN corepack yarn build

FROM nginx:1.28-alpine
COPY deploy/nginx.conf /etc/nginx/nginx.conf
COPY --from=build /app/build /usr/share/nginx/html
RUN apk update && apk upgrade --no-cache \
    && chown -R nginx:nginx /usr/share/nginx/html \
    && mkdir -p /tmp/client_body /tmp/proxy /tmp/fastcgi /tmp/uwsgi /tmp/scgi \
    && chown -R nginx:nginx /tmp/client_body /tmp/proxy /tmp/fastcgi /tmp/uwsgi /tmp/scgi
USER nginx
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
