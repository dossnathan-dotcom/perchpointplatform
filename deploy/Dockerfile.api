FROM python:3.13-slim
WORKDIR /app
COPY backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt \
    && python -m pip install --no-cache-dir --upgrade "setuptools==84.0.0" "wheel==0.46.2" "jaraco.context==6.1.0" "msgpack==1.2.1" \
    && find /usr /root -type d \( -name '*1.1.2.dist-info' -o -name '*70.3.0.dist-info' -o -name '*0.45.1.dist-info' -o -name '*5.3.0.dist-info' \) -print -exec rm -rf {} + \
    && find /usr /root -type f \( -name '*msgpack-1.1.2*' -o -name '*setuptools-70.3.0*' -o -name '*wheel-0.45.1*' -o -name '*jaraco.context-5.3.0*' -o -name '*jaraco_context-5.3.0*' \) -print -delete \
    && useradd --create-home --uid 10001 perchpoint
COPY backend /app
RUN chown -R perchpoint:perchpoint /app
ENV PYTHONPATH=/app
USER perchpoint
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "perchpoint.routes:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
