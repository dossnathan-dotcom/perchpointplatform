FROM python:3.13-slim@sha256:3dd7cc108ec1493442514f5c2a871af6af0ec31d768ff6e378a93340c3b3db5f
WORKDIR /app
COPY backend/requirements.txt /app/requirements.txt
COPY deploy/purge_old_packages.py /tmp/purge_old_packages.py
RUN apt-get update \
    && apt-get install -y --no-install-recommends tesseract-ocr \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir -r /app/requirements.txt \
    && python -m pip install --no-cache-dir --upgrade "setuptools==84.0.0" "wheel==0.46.2" "jaraco.context==6.1.0" "msgpack==1.2.1" \
    && python /tmp/purge_old_packages.py \
    && rm /tmp/purge_old_packages.py \
    && useradd --create-home --uid 10001 perchpoint
COPY backend /app
RUN chown -R perchpoint:perchpoint /app
ENV PYTHONPATH=/app
USER perchpoint
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "perchpoint.routes:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
