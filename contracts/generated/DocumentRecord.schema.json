{
  "$defs": {
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "assignment_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assignment Id"
        },
        "building_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Building Id"
        },
        "household_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Household Id"
        },
        "organization_id": {
          "format": "uuid",
          "title": "Organization Id",
          "type": "string"
        },
        "ownership_entity_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ownership Entity Id"
        },
        "property_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Property Id"
        },
        "unit_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit Id"
        }
      },
      "required": [
        "organization_id"
      ],
      "title": "Scope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "access_rule": {
      "title": "Access Rule",
      "type": "string"
    },
    "audit_required": {
      "title": "Audit Required",
      "type": "boolean"
    },
    "checksum_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Checksum Sha256",
      "type": "string"
    },
    "deletion_eligible": {
      "title": "Deletion Eligible",
      "type": "boolean"
    },
    "document_class": {
      "enum": [
        "application_document",
        "identity_document",
        "screening_document",
        "lease",
        "addendum",
        "notice",
        "payment_evidence",
        "maintenance_media",
        "estimate",
        "invoice",
        "insurance_policy",
        "vendor_credential",
        "inspection",
        "property_record",
        "legal_document",
        "communication_attachment",
        "migration_archive"
      ],
      "title": "Document Class",
      "type": "string"
    },
    "download_rule": {
      "title": "Download Rule",
      "type": "string"
    },
    "effective_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Effective At"
    },
    "expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Expires At"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "legal_hold": {
      "title": "Legal Hold",
      "type": "boolean"
    },
    "owner_organization_id": {
      "format": "uuid",
      "title": "Owner Organization Id",
      "type": "string"
    },
    "owner_person_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Owner Person Id"
    },
    "related_record_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Related Record Ids",
      "type": "array"
    },
    "retention_rule_id": {
      "format": "uuid",
      "title": "Retention Rule Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/Scope"
    },
    "sensitivity": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ],
      "title": "Sensitivity",
      "type": "string"
    },
    "source": {
      "title": "Source",
      "type": "string"
    },
    "storage_reference_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Storage Reference Id"
    },
    "synthetic": {
      "default": true,
      "title": "Synthetic",
      "type": "boolean"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "document_class",
    "owner_person_id",
    "owner_organization_id",
    "related_record_ids",
    "scope",
    "sensitivity",
    "version",
    "checksum_sha256",
    "source",
    "storage_reference_id",
    "effective_at",
    "expires_at",
    "retention_rule_id",
    "legal_hold",
    "access_rule",
    "download_rule",
    "deletion_eligible",
    "audit_required"
  ],
  "title": "DocumentRecord",
  "type": "object"
}
