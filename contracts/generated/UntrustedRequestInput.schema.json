{
  "additionalProperties": false,
  "description": "External request metadata. Never treated as authenticated actor context.",
  "properties": {
    "client_observed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Client Observed At"
    },
    "correlation_id": {
      "format": "uuid",
      "title": "Correlation Id",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 128,
      "minLength": 8,
      "title": "Idempotency Key",
      "type": "string"
    },
    "request_fingerprint": {
      "maxLength": 128,
      "minLength": 8,
      "title": "Request Fingerprint",
      "type": "string"
    }
  },
  "required": [
    "idempotency_key",
    "request_fingerprint",
    "correlation_id"
  ],
  "title": "UntrustedRequestInput",
  "type": "object"
}
