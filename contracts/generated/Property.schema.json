{
  "$defs": {
    "Address": {
      "additionalProperties": false,
      "properties": {
        "country": {
          "minLength": 2,
          "title": "Country",
          "type": "string"
        },
        "county": {
          "title": "County",
          "type": "string"
        },
        "is_example": {
          "title": "Is Example",
          "type": "boolean"
        },
        "line1": {
          "title": "Line1",
          "type": "string"
        },
        "municipality": {
          "title": "Municipality",
          "type": "string"
        },
        "postal_code": {
          "title": "Postal Code",
          "type": "string"
        },
        "state": {
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "line1",
        "country",
        "state",
        "county",
        "municipality",
        "postal_code",
        "is_example"
      ],
      "title": "Address",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "address": {
      "$ref": "#/$defs/Address"
    },
    "id": {
