      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "organization_id": {
      "format": "uuid",
      "title": "Organization Id",
      "type": "string"
    },
    "ownership_entity_id": {
      "format": "uuid",
      "title": "Ownership Entity Id",
      "type": "string"
    },
    "parcel_references": {
      "items": {
        "type": "string"
      },
      "title": "Parcel References",
      "type": "array"
    },
    "property_type": {
      "enum": [
        "single_family",
        "duplex",
        "triplex",
        "multifamily",
        "commercial",
        "mixed_use"
      ],
      "title": "Property Type",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "synthetic": {
      "default": true,
      "title": "Synthetic",
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "organization_id",
    "ownership_entity_id",
    "name",
    "property_type",
    "address"
  ],
  "title": "Property",
  "type": "object"
}
