{
  "$defs": {
    "CommercialTerms": {
      "additionalProperties": false,
      "properties": {
        "base_rent": {
          "$ref": "#/$defs/Money"
        },
        "build_out_status": {
          "title": "Build Out Status",
          "type": "string"
        },
        "cam_nnn_terms": {
          "title": "Cam Nnn Terms",
          "type": "string"
        },
        "deposit": {
          "$ref": "#/$defs/Money"
        },
        "intended_use": {
          "title": "Intended Use",
          "type": "string"
        },
        "lease_type": {
          "title": "Lease Type",
          "type": "string"
        },
        "loading_access": {
          "title": "Loading Access",
          "type": "string"
        },
        "parking": {
          "title": "Parking",
          "type": "string"
        },
        "rent_period": {
          "enum": [
            "month",
            "year"
          ],
          "title": "Rent Period",
          "type": "string"
        },
        "utility_responsibility": {
          "title": "Utility Responsibility",
          "type": "string"
        },
        "zoning_notes": {
          "title": "Zoning Notes",
          "type": "string"
        }
      },
      "required": [
        "intended_use",
        "base_rent",
        "rent_period",
        "deposit",
        "lease_type",
        "cam_nnn_terms",
        "utility_responsibility",
        "zoning_notes",
        "loading_access",
        "parking",
        "build_out_status"
      ],
      "title": "CommercialTerms",
      "type": "object"
    },
    "ExpectedVersion": {
      "additionalProperties": false,
      "properties": {
        "aggregate_id": {
          "format": "uuid",
          "title": "Aggregate Id",
          "type": "string"
        },
        "expected_version": {
          "minimum": 1,
          "title": "Expected Version",
          "type": "integer"
        }
      },
      "required": [
        "aggregate_id",
        "expected_version"
      ],
      "title": "ExpectedVersion",
      "type": "object"
    },
    "Money": {
      "additionalProperties": false,
      "properties": {
        "amount_minor": {
          "minimum": 0,
          "title": "Amount Minor",
          "type": "integer"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "amount_minor",
        "currency"
      ],
      "title": "Money",
      "type": "object"
    },
    "ResidentialTerms": {
      "additionalProperties": false,
      "properties": {
        "application_fee": {
          "$ref": "#/$defs/Money"
        },
        "bathrooms": {
          "minimum": 0,
          "title": "Bathrooms",
          "type": "number"
        },
        "bedrooms": {
          "minimum": 0,
          "title": "Bedrooms",
          "type": "integer"
        },
        "monthly_rent": {
          "$ref": "#/$defs/Money"
        },
        "pet_policy": {
          "title": "Pet Policy",
          "type": "string"
        },
        "security_deposit": {
          "$ref": "#/$defs/Money"
        },
        "utilities": {
          "title": "Utilities",
          "type": "string"
        }
      },
      "required": [
        "bedrooms",
        "bathrooms",
        "monthly_rent",
        "security_deposit",
        "application_fee",
        "utilities",
        "pet_policy"
      ],
      "title": "ResidentialTerms",
      "type": "object"
    },
    "UntrustedRequestInput": {
      "additionalProperties": false,
      "description": "External request metadata. Never treated as authenticated actor context.",
      "properties": {
        "client_observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Observed At"
        },
        "correlation_id": {
          "format": "uuid",
          "title": "Correlation Id",
          "type": "string"
        },
        "idempotency_key": {
          "maxLength": 128,
          "minLength": 8,
          "title": "Idempotency Key",
          "type": "string"
        },
        "request_fingerprint": {
          "maxLength": 128,
          "minLength": 8,
          "title": "Request Fingerprint",
          "type": "string"
        }
      },
      "required": [
        "idempotency_key",
        "request_fingerprint",
        "correlation_id"
      ],
      "title": "UntrustedRequestInput",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "building_id": {
      "format": "uuid",
      "title": "Building Id",
      "type": "string"
    },
    "commercial": {
      "anyOf": [
        {
          "$ref": "#/$defs/CommercialTerms"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "expected_version": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExpectedVersion"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "label": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Label",
      "type": "string"
    },
    "property_id": {
      "format": "uuid",
      "title": "Property Id",
      "type": "string"
    },
    "request": {
      "$ref": "#/$defs/UntrustedRequestInput"
    },
    "residential": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResidentialTerms"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "square_feet": {
      "exclusiveMinimum": 0,
      "title": "Square Feet",
      "type": "integer"
    },
    "use": {
      "enum": [
        "residential",
        "commercial"
      ],
      "title": "Use",
      "type": "string"
    }
  },
  "required": [
    "property_id",
    "building_id",
    "label",
    "use",
    "square_feet",
    "request"
  ],
  "title": "CreateLeasableSpace",
  "type": "object"
}
