{
  "$defs": {
    "Address": {
      "additionalProperties": false,
      "properties": {
        "country": {
          "minLength": 2,
          "title": "Country",
          "type": "string"
        },
        "county": {
          "title": "County",
          "type": "string"
        },
        "is_example": {
          "title": "Is Example",
          "type": "boolean"
        },
        "line1": {
          "title": "Line1",
          "type": "string"
        },
        "municipality": {
          "title": "Municipality",
          "type": "string"
        },
        "postal_code": {
          "title": "Postal Code",
          "type": "string"
        },
        "state": {
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "line1",
        "country",
        "state",
        "county",
        "municipality",
        "postal_code",
        "is_example"
      ],
      "title": "Address",
      "type": "object"
    },
    "ExpectedVersion": {
      "additionalProperties": false,
      "properties": {
        "aggregate_id": {
          "format": "uuid",
          "title": "Aggregate Id",
          "type": "string"
        },
        "expected_version": {
          "minimum": 1,
          "title": "Expected Version",
          "type": "integer"
        }
      },
      "required": [
        "aggregate_id",
        "expected_version"
      ],
      "title": "ExpectedVersion",
      "type": "object"
    },
    "UntrustedRequestInput": {
      "additionalProperties": false,
      "description": "External request metadata. Never treated as authenticated actor context.",
      "properties": {
        "client_observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Observed At"
        },
        "correlation_id": {
          "format": "uuid",
          "title": "Correlation Id",
          "type": "string"
        },
        "idempotency_key": {
          "maxLength": 128,
          "minLength": 8,
          "title": "Idempotency Key",
          "type": "string"
        },
        "request_fingerprint": {
          "maxLength": 128,
          "minLength": 8,
          "title": "Request Fingerprint",
          "type": "string"
        }
      },
      "required": [
        "idempotency_key",
        "request_fingerprint",
        "correlation_id"
      ],
      "title": "UntrustedRequestInput",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "address": {
      "$ref": "#/$defs/Address"
    },
    "expected_version": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExpectedVersion"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "name": {
      "maxLength": 160,
      "minLength": 2,
      "title": "Name",
      "type": "string"
    },
    "parcel_references": {
      "items": {
        "type": "string"
      },
      "title": "Parcel References",
      "type": "array"
    },
    "property_type": {
      "enum": [
        "single_family",
        "duplex",
        "triplex",
        "multifamily",
        "commercial",
        "mixed_use"
      ],
      "title": "Property Type",
      "type": "string"
    },
    "request": {
      "$ref": "#/$defs/UntrustedRequestInput"
    }
  },
  "required": [
    "name",
    "property_type",
    "address",
    "request"
  ],
  "title": "CreateProperty",
  "type": "object"
}
