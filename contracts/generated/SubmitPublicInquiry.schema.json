{
  "$defs": {
    "UntrustedRequestInput": {
      "additionalProperties": false,
      "description": "External request metadata. Never treated as authenticated actor context.",
      "properties": {
        "client_observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Observed At"
        },
        "correlation_id": {
          "format": "uuid",
          "title": "Correlation Id",
          "type": "string"
        },
        "idempotency_key": {
          "maxLength": 128,
          "minLength": 8,
          "title": "Idempotency Key",
          "type": "string"
        },
        "request_fingerprint": {
          "maxLength": 128,
          "minLength": 8,
          "title": "Request Fingerprint",
          "type": "string"
        }
      },
      "required": [
        "idempotency_key",
        "request_fingerprint",
        "correlation_id"
      ],
      "title": "UntrustedRequestInput",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Public write. Does not grant staff identity or read of internal records.",
  "properties": {
    "email": {
      "maxLength": 254,
      "minLength": 6,
      "title": "Email",
      "type": "string"
    },
    "intent": {
      "enum": [
        "showing",
        "application",
        "contact",
        "other"
      ],
      "title": "Intent",
      "type": "string"
    },
    "listing_id": {
      "format": "uuid",
      "title": "Listing Id",
      "type": "string"
    },
    "message": {
      "default": "",
      "maxLength": 1600,
      "title": "Message",
      "type": "string"
    },
    "name": {
      "maxLength": 120,
      "minLength": 2,
      "title": "Name",
      "type": "string"
    },
    "preferred_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Preferred Date"
    },
    "request": {
      "$ref": "#/$defs/UntrustedRequestInput"
    }
  },
  "required": [
    "listing_id",
    "name",
    "email",
    "intent",
    "request"
  ],
  "title": "SubmitPublicInquiry",
  "type": "object"
}
