# Local Phase 2 only. Copy to backend/.env. Do not commit secrets.
# PHASE2_LOCAL_AUTH must stay development. Staging and production reject it.
# PHASE3_ENVIRONMENT is local, test, ci, staging, or production.
# Leave SENTRY_DSN unset until a real DSN is injected outside git.
PHASE3_ENVIRONMENT=local
PHASE2_LOCAL_AUTH=development
PHASE2_ADMIN_URL=postgresql://postgres:replace-me@127.0.0.1:5432/postgres
PHASE2_MIGRATOR_URL=postgresql://perchpoint_migrator:replace-me@127.0.0.1:5432/perchpoint_phase2
PHASE2_RUNTIME_URL=postgresql://perchpoint_runtime:replace-me@127.0.0.1:5432/perchpoint_phase2
PHASE2_JWT_SECRET=replace-with-a-long-local-secret
PHASE2_DEV_PASSWORD=replace-with-a-local-synthetic-password
PHASE2_WEBHOOK_SECRET=replace-with-a-local-webhook-secret
